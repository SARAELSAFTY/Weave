  speaker: {fileID: 0}
  descriptionLocalized:
    english: "you go to see the seer again, something in her words makes you doubt
      every thing surrounds you.\r\nthe seer: my lord, what a pleasure, looking for
      answers?\r\nyou tell her to get to the point.\r\nthe seer: By your side, you
      see them in your halls\u2014long lost, breathing meat. Different names, but
      the same blue blood."
    arabic: "\u062A\u0630\u0647\u0628 \u0644\u0631\u0624\u064A\u0629 \u0627\u0644\u0639\u0631\u0651\u0627\u0641\u0629
      \u0645\u062C\u062F\u062F\u0627\u064B\u060C \u0641\u0634\u064A\u0621\u064C \u0645\u0627
      \u0641\u064A \u0643\u0644\u0645\u0627\u062A\u0647\u0627 \u064A\u062C\u0639\u0644\u0643
      \u062A\u0634\u0643 \u0641\u064A \u0643\u0644 \u0645\u0627 \u064A\u062D\u064A\u0637
      \u0628\u0643.\n\u0627\u0644\u0639\u0631\u0651\u0627\u0641\u0629: \xAB\u064A\u0627
      \u0645\u0648\u0644\u0627\u064A\u060C \u064A\u0627 \u0644\u0647\u0627 \u0645\u0646
      \u0645\u0633\u0631\u0651\u0629... \u0623\u062A\u0628\u062D\u062B \u0639\u0646
      \u0625\u062C\u0627\u0628\u0627\u062A\u061F\xBB\n\u062A\u0637\u0644\u0628 \u0645\u0646\u0647\u0627
      \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0644\u0628
      \u0648\u0627\u0644\u0645\u063A\u0632\u0649 \u0645\u0628\u0627\u0634\u0631\u0629\u064B.\n\u0627\u0644\u0639\u0631\u0651\u0627\u0641\u0629:
      \xAB\u0625\u0644\u0649 \u062C\u0648\u0627\u0631\u0643\u060C \u062A\u0631\u0627\u0647\u0645
      \u0641\u064A \u0642\u0627\u0639\u0627\u062A\u0643... \u063A\u0627\u0626\u0628\u0648\u0646
      \u0645\u0646\u0630 \u0632\u0645\u0646\u060C \u0644\u062D\u0645\u064C \u064A\u062A\u0646\u0641\u0633.
      \u0623\u0633\u0645\u0627\u0621\u064C \u0645\u062E\u062A\u0644\u0641\u0629\u060C
      \u0644\u0643\u0646\u0647 \u0627\u0644\u062F\u0645 \u0627\u0644\u0623\u0632\u0631\u0642
      \u0627\u0644\u0645\u0644\u0643\u064A \u0630\u0627\u062A\u0647.\xBB"
