  m_Script: {fileID: 11500000, guid: 3a58f704bd5e67641b99574144c55bc6, type: 3}
  m_Name: Card_33_SmugglerBargain
  m_EditorClassIdentifier: 
  assetName: Card_33_SmugglerBargain
  displayNameLocalized:
    english: 
    arabic: 
  speaker: {fileID: 11400000, guid: bd422fef7c7a0976bcb3c39364963115, type: 2}
  descriptionLocalized:
    english: "Treasurer: 'Sire, a guild of private smugglers offers to move foreign
      goods under the Western Kingdom's nose \u2014 provided we extend them certain...
      administrative courtesies. The margin is considerable, I assure you.'"
    arabic: "\u0623\u0645\u064A\u0646 \u0627\u0644\u062E\u0632\u064A\u0646\u0629:
      \xAB\u064A\u0627 \u0645\u0648\u0644\u0627\u064A\u060C \u0645\u062C\u0645\u0648\u0639\u0629
      \u0645\u0646 \u0627\u0644\u0645\u0647\u0631\u0628\u064A\u0646 \u0645\u0633\u062A\u0639\u062F\u0629
      \u0644\u062A\u0647\u0631\u064A\u0628 \u0628\u0636\u0627\u0626\u0639 \u0623\u062C\u0646\u0628\u064A\u0629
      \u062A\u062D\u062A \u0623\u0646\u0641 \u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u063A\u0631\u0628\u060C
      \u0645\u0642\u0627\u0628\u0644 \u062A\u0633\u0647\u064A\u0644\u0627\u062A \u0625\u062F\u0627\u0631\u064A\u0629
      \u0628\u0633\u064A\u0637\u0629. \u0627\u0644\u0639\u0627\u0626\u062F \u0648\u0641\u064A\u0631
      \u064A\u0627 \u0633\u064A\u062F\u064A.\xBB"
  dayAdvance: 1
  leftChoiceLocalized:
    english: License the smugglers quietly; survival requires cunning.
    arabic: "\u0631\u062E\u0651\u0635 \u0644\u0647\u0645 \u0633\u0631\u0627\u064B\u061B
      \u0641\u0627\u0644\u0628\u0642\u0627\u0621 \u0641\u064A \u0627\u0644\u0623\u0632\u0645\u0627\u062A
      \u064A\u062A\u0637\u0644\u0628 \u0627\u0644\u062F\u0647\u0627\u0621."
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: -5
    - resource: {fileID: 11400000, guid: 1bd4e23f03990bc4d9ab64de0475c474, type: 2}
      value: 10
    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: 5
  leftNextCard: {fileID: 11400000, guid: 73757d5d33ead2505f585d8a8ce14d1d, type: 2}
  rightChoiceLocalized:
    english: Hang the smugglers; the realm will not deal in vice.
    arabic: "\u0627\u0642\u0628\u0636 \u0639\u0644\u0649 \u0627\u0644\u0645\u0647\u0631\u0628\u064A\u0646\u061B
      \u0641\u0644\u0646 \u064A\u062F\u0646\u0633 \u0627\u0644\u062A\u0627\u062C
      \u0634\u0631\u0641\u0647 \u0628\u0627\u0644\u062E\u0631\u0648\u062C \u0639\u0646
      \u0627\u0644\u0642\u0627\u0646\u0648\u0646."
  rightResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
