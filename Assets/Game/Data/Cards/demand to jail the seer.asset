  speaker: {fileID: 0}
  descriptionLocalized:
    english: 'The Jester playfully  proposes a wild idea: hold public court where
      ANY citizen can appeal to you

      directly. The Chancellor calls it chaos.'
    arabic: "\u064A\u064E\u0637\u0631\u062D \u0627\u0644\u0645\u0647\u0631\u062C
      \u0628\u0623\u0633\u0644\u0648\u0628\u0647 \u0627\u0644\u0645\u0627\u0643\u0631
      \u0648\u0627\u0644\u0645\u0631\u062D \u0641\u0643\u0631\u0629\u064B \u062C\u0627\u0645\u062D\u0629:
      \u0639\u0642\u062F \u062C\u0644\u0633\u0629 \u0628\u0644\u0627\u0637 \u0639\u0644\u0646\u064A\u0629
      \u0648\u0645\u0641\u062A\u0648\u062D\u0629 \u064A\u064F\u0633\u0645\u062D \u0641\u064A\u0647\u0627
      \u0644\u0623\u064A \u0645\u0648\u0627\u0637\u0646 \u0628\u062A\u0642\u062F\u064A\u0645
      \u0645\u0638\u0644\u0645\u062A\u0647 \u0625\u0644\u064A\u0643 \u0645\u0628\u0627\u0634\u0631\u0629\u064B.
      \u0627\u0644\u0645\u0633\u062A\u0634\u0627\u0631 \u064A\u0635\u0641 \u0627\u0644\u0641\u0643\u0631\u0629
      \u0641\u0648\u0631\u0627\u064B \u0628\u0623\u0646\u0647\u0627 \xAB\u0641\u0648\u0636\u0649
      \u0639\u0627\u0631\u0645\u0629\xBB."
  dayAdvance: 1
  leftChoiceLocalized:
    english: Institute public court
    arabic: "\u062A\u0623\u0633\u064A\u0633 \u0645\u062D\u0643\u0645\u0629 \u0634\u0639\u0628\u064A\u0629
      \u0639\u0644\u0646\u064A\u0629."
