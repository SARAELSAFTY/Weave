  leftNextCard: {fileID: 11400000, guid: d5e16d058ec960c4ab8f797bd4ed8d2a, type: 2}
  rightChoiceLocalized:
    english: "Reject the idea—maintain hierarchy."
    arabic: "رفض الفكرة—والتمسك بالتراتبية الملكية."
