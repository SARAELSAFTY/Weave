  leftNextCard: {fileID: 11400000, guid: 095847a3b777b777109671f82e422d08, type: 2}
  rightChoiceLocalized:
    english: "Assess the realm's balance and decree my final reign."
    arabic: "استعرض حال المملكة وأصدر مرسوم الحكم النهائي."
  rightResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
