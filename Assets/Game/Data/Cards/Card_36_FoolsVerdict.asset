  speaker: {fileID: 11400000, guid: 58e0d26dc32b25229dc4aef014036958, type: 2}
  descriptionLocalized:
    english: "The Jester stands and bows deeply: 'The hour of your legacy has arrived, Sire. Will you seal the bond of blood, rule with absolute iron, or leave the golden cage behind?'"
    arabic: "يقف البهلوان وينحني بإجلال عميق: «دقت ساعة الحصاد يا مولاي. فهل نتوج عهد الأخوة المشتركة، أم تحكم بالحديد والنار، أم تغادر هذا القفص الذهبي؟»"
  dayAdvance: 1
  leftChoiceLocalized:
    english: "Crown my brother beside me; two brothers upon one throne!"
    arabic: "تتويج أخي شريكاً على العرش؛ أخوان على عرش واحد!"
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
