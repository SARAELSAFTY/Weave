  speaker: {fileID: 11400000, guid: 220c64b1d598ddf41bc3f43bc6849160, type: 2}
  descriptionLocalized:
    english: "Chancellor: 'The Eastern Kingdom welcomes an envoy, Sire! But their frontier provinces suffer from drought. Sending grain would seal their goodwill.'"
    arabic: "المستشار: «رحبت مملكة الشرق بسفيرنا يا مولاي! غير أن أقاليمهم الحدودية تعاني الجفاف. إرسال معونات قمح سيضمن صداقتهم.»"
  dayAdvance: 1
  leftChoiceLocalized:
    english: "Dispatch fifty wagons of royal grain."
    arabic: "أرسل خمسين عربة قمح من مستودعاتنا فوراً."
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: 5
    - resource: {fileID: 11400000, guid: 1bd4e23f03990bc4d9ab64de0475c474, type: 2}
      value: -10
    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: 10
  leftNextCard: {fileID: 11400000, guid: 54d1e63eadd8e692581546620b1dc6d5, type: 2}
  rightChoiceLocalized:
    english: "Send words of sympathy and modest gifts."
    arabic: "أرسل رسائل مواساة وهدايا رمزية فقط."
  rightResourceChange:
