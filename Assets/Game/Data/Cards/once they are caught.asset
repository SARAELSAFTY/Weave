  speaker: {fileID: 11400000, guid: dfdc22d7b454b71478810c37f9f3f190, type: 2}
  descriptionLocalized:
    english: "The Treasury Adviser didn't just take coin; he’s been smuggling the royal kitchen spices and selling state secrets to rival merchants! What are you going to do about it... brother?"
    arabic: "لم يكتفِ مستشار الخزانة بنهب الذهب؛ بل كان يهرب نفائس التوابل ويبيع أسرار الدولة للتجار الأجانب! ما الذي ستفعله حيال ذلك الآن... يا أخي؟"
  dayAdvance: 1
  leftChoiceLocalized:
    english: "Spices and silver are nothing compared to your insolence! Guards!"
    arabic: "وقاحتك أعظم جرماً من سرقة التوابل! أيها الحرس، خذوه!"
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: -15
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: 10
  leftNextCard: {fileID: 11400000, guid: cb033306c6d295140b084dbda12d174f, type: 2}
  rightChoiceLocalized:
    english: "You call me 'brother'? Prove your words or face the blade."
    arabic: "أتدعوني 'أخاك'؟ أثبت قولك وإلا قطعت رأسك!"
  rightResourceChange:
