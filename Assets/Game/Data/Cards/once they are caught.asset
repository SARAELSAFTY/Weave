  speaker: {fileID: 0}
  descriptionLocalized:
    english: 'the jester: your The Treasury Adviser been stealing from the castel
      vault and selling the kitchen spices to nobel and merchents, what are you going
      to do ,brother?

      you look in shock'
    arabic: "\u0627\u0644\u0645\u0647\u0631\u062C: \"\u0645\u0633\u062A\u0634\u0627\u0631
      \u0627\u0644\u062E\u0632\u0627\u0646\u0629 \u0643\u0627\u0646 \u064A\u0633\u0631\u0642
      \u0645\u0646 \u062E\u0632\u064A\u0646\u0629 \u0627\u0644\u0642\u0644\u0639\u0629
      \u0648\u064A\u0628\u064A\u0639 \u0628\u0647\u0627\u0631\u0627\u062A \u0627\u0644\u0645\u0637\u0628\u062E
      \u0644\u0644\u0646\u0628\u0644\u0627\u0621 \u0648\u0627\u0644\u062A\u062C\u0627\u0631\u060C
      \u0645\u0627\u0630\u0627 \u0633\u062A\u0641\u0639\u0644 \u0627\u0644\u0622\u0646
      \u064A\u0627 \u0623\u062E\u064A\u061F\"\n\u062A\u0646\u0638\u0631 \u0625\u0644\u064A\u0647
      \u0641\u064A \u0635\u062F\u0645\u0629."
  dayAdvance: 1
  leftChoiceLocalized:
    english: Spices and silver are nothing compared to what you just called me. Guards,
      take this rubbish!
    arabic: "\"\u0627\u0644\u062A\u0648\u0627\u0628\u0644 \u0648\u0627\u0644\u0641\u0636\u0629
      \u0644\u0627 \u062A\u0633\u0627\u0648\u064A \u0634\u064A\u0626\u064B\u0627
      \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0645\u0627 \u062F\u0639\u0648\u062A\u0646\u064A
      \u0628\u0647 \u0644\u0644\u062A\u0648. \u0623\u064A\u062A\u0647\u0627 \u0627\u0644\u062D\u0631\u0633\u060C
      \u062E\u0630\u0648\u0627 \u0647\u0630\u0627 \u0627\u0644\u0642\u0645\u0627\u0645\u0629
      \u0645\u0646 \u0623\u0645\u0627\u0645\u064A!\""
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: -15
  leftNextCard: {fileID: 11400000, guid: cb033306c6d295140b084dbda12d174f, type: 2}
  rightChoiceLocalized:
    english: "I will take that as a funny joke of yours\u2014unless you have proof
      to show me, or you will be beheaded for telling lies."
    arabic: "\"\u0633\u0623\u0639\u062A\u0628\u0631 \u0647\u0630\u0627 \u0645\u062C\u0631\u062F
      \u062F\u0639\u0627\u0628\u0629 \u0633\u062E\u064A\u0641\u0629 \u0645\u0646\u0643\u2014\u0645\u0627
      \u0644\u0645 \u062A\u0643\u0646 \u0644\u062F\u064A\u0643 \u0623\u062F\u0644\u0629
      \u0644\u062A\u0639\u0631\u0636\u0647\u0627 \u0639\u0644\u064A\u0651\u060C \u0648\u0625\u0644\u0627
      \u0641\u0633\u064A\u064F\u0642\u0637\u0639 \u0631\u0623\u0633\u0643 \u0644\u0642\u0648\u0644\u0643
      \u0627\u0644\u0623\u0643\u0627\u0630\u064A\u0628.\""
