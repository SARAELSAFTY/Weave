  speaker: {fileID: 11400000, guid: 968d4d0248269710a22f4c7dabc6a9cd, type: 2}
  descriptionLocalized:
    english: "General: 'Your mercy impressed the town elders, Sire. They surrendered their weapon caches, but our soldiers grumble about missed plunder.'"
    arabic: "الجنرال: «أثرت رحمتك في كبار قريتهم، فسلّموا مخازن سلاحهم طوعاً؛ غير أن جندنا يتذمرون لحرمانهم من الغنائم.»"
  dayAdvance: 1
  leftChoiceLocalized:
    english: "Pay the troops a modest royal bonus."
    arabic: "اصرف مكافأة ترضية للجند من الخزينة الخاصة."
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: 5
    - resource: {fileID: 11400000, guid: 1bd4e23f03990bc4d9ab64de0475c474, type: 2}
      value: -15
    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: 15
  leftNextCard: {fileID: 11400000, guid: 88d6533661b6ecf7ddbe8128aace5dd3, type: 2}
  rightChoiceLocalized:
    english: "Remind them of military discipline; no bonuses."
    arabic: "ذكّرهم بالانضباط العسكري؛ لا غنائم على حساب الشرف."
  rightResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
