  assetName: Card_31_TreasuryDepleted
  displayNameLocalized:
    english: 
    arabic: 
  speaker: {fileID: 11400000, guid: bd422fef7c7a0976bcb3c39364963115, type: 2}
  descriptionLocalized:
    english: "Treasurer: 'Sire, Western merchants have bought out our domestic grain reserves. Market prices are spiraling upward — the treasury cannot absorb this. We must act before the city turns.'"
    arabic: "أمين الخزينة: «يا مولاي، استنزف تجار الغرب احتياطياتنا المحلية! أسعار الأسواق تلتهب والخزينة عاجزة عن الاستيعاب، علينا التحرك قبل أن تنفجر المدينة.»"
  dayAdvance: 1
  leftChoiceLocalized:
    english: "Subsidize bakeries from the royal reserves."
    arabic: "ادعم المخابز بالدقيق فوراً من الاحتياطي الملكي."
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: 10
    - resource: {fileID: 11400000, guid: 1bd4e23f03990bc4d9ab64de0475c474, type: 2}
      value: -15
    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: 0
  leftNextCard: {fileID: 11400000, guid: 73757d5d33ead2505f585d8a8ce14d1d, type: 2}
  rightChoiceLocalized:
    english: "Ban the export of all edible grains immediately."
    arabic: "امنع تصدير الحبوب والقمح إلى الخارج كلياً."
  rightResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: 5
    - resource: {fileID: 11400000, guid: 1bd4e23f03990bc4d9ab64de0475c474, type: 2}
      value: -5
    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: 5
