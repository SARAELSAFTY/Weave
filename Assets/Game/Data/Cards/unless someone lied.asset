  m_Script: {fileID: 11500000, guid: 3a58f704bd5e67641b99574144c55bc6, type: 3}
  m_Name: unless someone lied
  m_EditorClassIdentifier: 
  assetName: unless someone lied
  displayNameLocalized:
    english: 
    arabic: 
  speaker: {fileID: 0}
  descriptionLocalized:
    english: "Your solo investigation leads to a long-lost half-brother from your
      father's side\u2014the result of an illegitimate affair. But there is nowhere
      to find him. The only two people in the castle with no records, who could carry
      that blue blood, are:"
    arabic: "\u064A\u064E\u0642\u0648\u062F\u064F\u0643 \u062A\u062D\u0631\u0651\u064A\u0643
      \u0627\u0644\u0641\u0631\u062F\u064A \u0625\u0644\u0649 \u0648\u062C\u0648\u062F
      \u0623\u062E\u064D \u063A\u064A\u0631 \u0634\u0642\u064A\u0642 \u0645\u0641\u0642\u0648\u062F
      \u0645\u0646\u0630 \u0632\u0645\u0646 \u0628\u0639\u064A\u062F \u0645\u0646
      \u0637\u0631\u0641 \u0648\u0627\u0644\u062F\u0643\u2014\u0646\u062A\u064A\u062C\u0629
      \u0639\u0644\u0627\u0642\u0629 \u063A\u064A\u0631 \u0634\u0631\u0639\u064A\u0629.
      \u0648\u0644\u0643\u0646 \u0644\u0627 \u064A\u0648\u062C\u062F \u0623\u064A
      \u0623\u062B\u0631\u064D \u0644\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u064A\u0647.
      \u0648\u0627\u0644\u0634\u062E\u0635\u0627\u0646 \u0627\u0644\u0648\u062D\u064A\u062F\u0627\u0646
      \u0641\u064A \u0627\u0644\u0642\u0635\u0631 \u0627\u0644\u0644\u0630\u0627\u0646
      \u0644\u0627 \u064A\u0645\u0644\u0643\u0627\u0646 \u0623\u064A \u0633\u062C\u0644\u0627\u062A
      \u0631\u0633\u0645\u064A\u0629\u060C \u0648\u0627\u0644\u0644\u0630\u0627\u0646
      \u064A\u0645\u0643\u0646 \u0623\u0646 \u064A\u062D\u0645\u0644\u0627 \u0630\u0644\u0643
      \u0627\u0644\u062F\u0645 \u0627\u0644\u0623\u0632\u0631\u0642 \u0627\u0644\u0645\u0644\u0643\u064A\u060C
      \u0647\u0645\u0627:"
