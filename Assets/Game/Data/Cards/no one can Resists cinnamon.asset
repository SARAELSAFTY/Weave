  speaker: {fileID: 0}
  descriptionLocalized:
    english: "the General:My Lord, the Chancellor demands that you be placed on trial
      before the High Church!.\r\nThe Seer\u2019s cryptic visions were reported to
      the Church, allowing the Chancellor to claim you are seeking dark omens and
      witchcraft instead of divine guidance.\r\n"
    arabic: "\u0627\u0644\u062C\u0646\u0631\u0627\u0644: \xAB\u064A\u0627 \u0645\u0648\u0644\u0627\u064A\u060C
      \u064A\u0637\u0627\u0644\u0628 \u0627\u0644\u0645\u0633\u062A\u0634\u0627\u0631
      \u0628\u0625\u062D\u0627\u0644\u062A\u0643 \u0625\u0644\u0649 \u0627\u0644\u0645\u062D\u0627\u0643\u0645\u0629
      \u0623\u0645\u0627\u0645 \u0627\u0644\u0643\u0646\u064A\u0633\u0629 \u0627\u0644\u0639\u0644\u064A\u0627!
      \u0644\u0642\u062F \u0631\u064F\u0641\u0639\u062A \u0631\u0624\u0649 \u0627\u0644\u0639\u0631\u0651\u0627\u0641
      \u0627\u0644\u063A\u0627\u0645\u0636\u0629 \u0625\u0644\u0649 \u0627\u0644\u0643\u0646\u064A\u0633\u0629\u060C
      \u0645\u0645\u0627 \u0633\u0645\u062D \u0644\u0644\u0645\u0633\u062A\u0634\u0627\u0631
      \u0628\u0627\u0644\u0627\u062F\u0639\u0627\u0621 \u0628\u0623\u0646\u0643 \u062A\u0628\u062D\u062B
      \u0639\u0646 \u0627\u0644\u0637\u0648\u0627\u0644\u0639 \u0627\u0644\u0645\u0638\u0644\u0645\u0629
      \u0648\u0627\u0644\u0633\u062D\u0631 \u0628\u062F\u0644\u0627\u064B \u0645\u0646
      \u0627\u0644\u0647\u062F\u0627\u064A\u0629 \u0627\u0644\u0625\u0644\u0647\u064A\u0629.\xBB   "
