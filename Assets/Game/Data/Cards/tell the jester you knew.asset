  speaker: {fileID: 11400000, guid: dfdc22d7b454b71478810c37f9f3f190, type: 2}
  descriptionLocalized:
    english: "The veil drops! The Chancellor arms bandits on our borders; the Treasury Adviser bleeds the merchant vaults dry; and your ministers conceal an imminent war from the General!"
    arabic: "سقط القناع أخيراً! المستشار يسرب السلاح للعصابات على حدودنا؛ ومستشار الخزانة يستنزف قوافل التجار لحسابه الخاص؛ وحاشيتك تخفي نذر حرب طاحنة وشيكة عن مسامع الجنرال!"
  dayAdvance: 1
  leftChoiceLocalized:
    english: "I am no fool. We purge this corruption."
    arabic: "لستُ أحمق كما ظننتم. سنستأصل هذا الفساد."
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: -10
    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: 15
  leftNextCard: {fileID: 11400000, guid: 3dfe6bd9a94850c4f85825217bf11e82, type: 2}
  rightChoiceLocalized:
    english: "Prepare the court for retribution."
    arabic: "أعدوا البلاط للمحاسبة والانتقام."
