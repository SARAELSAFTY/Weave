  m_Name: tell the jester you knew
  m_EditorClassIdentifier: 
  assetName: tell the jester you knew
  displayNameLocalized:
    english: 
    arabic: 
  speaker: {fileID: 0}
  descriptionLocalized:
    english: 'the jester tells you everything that was happening behind you back

      -The
      Chancellor been sending money and weapons to a Banditry

      -the treasury
      advisor been stealing from the lower vaults and passing tariffs whenever he
      likes on merchants

      -the general is facing a big comming war and your
      advisor hidding it.

'
    arabic: "\u064A\u0643\u0634\u0641 \u0644\u0643 \u0627\u0644\u0645\u0647\u0631\u062C
      \u0643\u0644 \u0645\u0627 \u0643\u0627\u0646 \u064A\u062C\u0631\u064A \u062E\u0644\u0641
      \u0638\u0647\u0631\u0643:\n\n- \u0627\u0644\u0645\u0633\u062A\u0634\u0627\u0631
      \u0643\u0627\u0646 \u064A\u0631\u0633\u0644 \u0627\u0644\u0623\u0645\u0648\u0627\u0644
      \u0648\u0627\u0644\u0623\u0633\u0644\u062D\u0629 \u0625\u0644\u0649 \u0627\u0644\u0639\u0635\u0627\u0628\u0627\u062A
      \u0648\u0642\u0637\u0651\u0627\u0639 \u0627\u0644\u0637\u0631\u0642.\n- \u0645\u0633\u062A\u0634\u0627\u0631
      \u0627\u0644\u062E\u0632\u0627\u0646\u0629 \u0643\u0627\u0646 \u064A\u0633\u0631\u0642
      \u0645\u0646 \u0627\u0644\u062E\u0632\u0627\u0626\u0646 \u0627\u0644\u0633\u0641\u0644\u0649
      \u0648\u064A\u0641\u0631\u0636 \u0631\u0633\u0648\u0645\u0627\u064B \u062C\u0645\u0631\u0643\u064A\u0629
      \u0648\u0641\u0642 \u0623\u0647\u0648\u0627\u0626\u0647 \u0639\u0644\u0649
      \u0627\u0644\u062A\u062C\u0627\u0631.\n- \u0627\u0644\u062C\u0646\u0631\u0627\u0644
      \u064A\u0648\u0627\u062C\u0647 \u062D\u0631\u0628\u0627\u064B \u0648\u0634\u064A\u0643\u0629
      \u0648\u0643\u0628\u064A\u0631\u0629\u060C \u0628\u064A\u0646\u0645\u0627 \u064A\u062E\u0641\u064A
      \u0645\u0633\u062A\u0634\u0627\u0631\u0643 \u0627\u0644\u062E\u0627\u0635 \u062E\u0628\u0631\u0647\u0627
      \u0639\u0646\u0643."
