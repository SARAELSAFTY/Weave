    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: -5
  leftNextCard: {fileID: 11400000, guid: af2769d780a22fee94fe12dd0f993e96, type: 2}
  rightChoiceLocalized:
    english: "Keep tariffs low to encourage trade volume."
    arabic: "أبقِ الرسوم منخفضة لتشجيع رواج التجارة."
