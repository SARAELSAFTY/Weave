  speaker: {fileID: 11400000, guid: bd422fef7c7a0976bcb3c39364963115, type: 2}
  descriptionLocalized:
    english: "Treasurer: 'Merchandise flows smoothly across the border, Sire! We could double the transit tariffs on their silk and spice wagons.'"
    arabic: "أمين الخزينة: «البضائع تتدفق عبر الحدود بسلاسة يا مولاي! يسعنا مضاعفة الرسوم على قوافل الحرير والتوابل.»"
  dayAdvance: 1
  leftChoiceLocalized:
    english: "Increase the tariffs; fill the royal treasury."
    arabic: "ارفع الرسوم الجمركية؛ لنملأ خزائن التاج بالذهب."
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: -5
    - resource: {fileID: 11400000, guid: 1bd4e23f03990bc4d9ab64de0475c474, type: 2}
