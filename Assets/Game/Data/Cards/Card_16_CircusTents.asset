    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: 0
  leftNextCard: {fileID: 11400000, guid: 39d09566b34bbba51cac26819334e977, type: 2}
  rightChoiceLocalized:
    english: "Silence, fool! Speak no insolence of my father."
    arabic: "اصمت يا أحمق! لا تتفوه بوقاحة عن والدي الملك."
  rightResourceChange:
