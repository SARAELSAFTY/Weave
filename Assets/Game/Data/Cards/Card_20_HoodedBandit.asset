    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: 10
  leftNextCard: {fileID: 11400000, guid: 231417746042b1c3aedb65b4f7e8febf, type: 2}
  rightChoiceLocalized:
    english: "Turn the Bandit into a double agent to bait him!"
    arabic: "استدرج المستشار واجعل قاطع الطريق عميلاً مزدوجاً!"
  rightResourceChange:
