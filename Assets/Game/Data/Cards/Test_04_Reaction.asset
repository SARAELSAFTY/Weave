      \u0628\u0646\u0635\u0651 \u0628\u0630\u0631 \u0645\u062E\u0635\u0635. \u064A\u062C\u0628
      \u0623\u0646 \u064A\u0633\u0645\u0651\u064A \u0627\u0644\u0631\u062F\u0651
      \u0627\u0644\u062D\u0627\u0645\u064A\u0629\u064E \u0627\u0644\u0634\u0631\u0642\u064A\u0629
      \u0648\u0627\u0644\u0636\u0627\u0628\u0637\u064E \u0627\u0644\u0630\u064A \u0631\u0641\u0636
