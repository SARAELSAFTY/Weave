  assetName: refuse
  displayNameLocalized:
    english: 
    arabic: 
  speaker: {fileID: 0}
  descriptionLocalized:
    english: 'Looking at the mirror, you start to grow suspicious about your advisor.
      You remember the seer''s vision, but there is no proof. You came up with a
      crazy idea: use the jester as a spy.'
    arabic: "\u062A\u0646\u0638\u0631 \u0625\u0644\u0649 \u0627\u0644\u0645\u0631\u0622\u0629
      \u0641\u062A\u062A\u0633\u0644\u0644 \u0627\u0644\u0634\u0643\u0648\u0643 \u0625\u0644\u0649
      \u0642\u0644\u0628\u0643 \u062A\u062C\u0627\u0647 \u0645\u0633\u062A\u0634\u0627\u0631\u0643.
      \u062A\u062A\u0630\u0643\u0631 \u0631\u0624\u064A\u0627 \u0627\u0644\u0631\u0627\u0626\u064A\u060C
      \u0644\u0643\u0646 \u0644\u0627 \u064A\u0648\u062C\u062F \u062F\u0644\u064A\u0644
      \u0648\u0627\u062D\u062F \u0628\u064A\u0646 \u064A\u062F\u064A\u0643. \u0647\u0646\u0627
      \u062A\u062E\u0637\u0631 \u0644\u0643 \u0641\u0643\u0631\u0629 \u062C\u0646\u0648\u0646\u064A\u0629:
      \u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0627\u0644\u0645\u0647\u0631\u062C
      \u0643\u062C\u0627\u0633\u0648\u0633."
  dayAdvance: 5
  leftChoiceLocalized:
    english: no, way too risky, if they knew hey would strip me of the crown before
      I could act.
    arabic: "\u0645\u0633\u062A\u062D\u064A\u0644\u060C \u0641\u0647\u0630\u0627
      \u0645\u062C\u0627\u0632\u0641\u0629 \u0643\u0628\u064A\u0631\u0629\u060C \u0644\u0648
      \u0639\u0644\u0645\u0648\u0627 \u0628\u0627\u0644\u0623\u0645\u0631 \u0644\u062C\u0631\u0651\u062F\u0648\u0646\u064A
      \u0645\u0646 \u0627\u0644\u062A\u0627\u062C \u0642\u0628\u0644 \u0623\u0646
      \u0623\u062A\u0645\u0643\u0646 \u0645\u0646 \u0627\u0644\u062A\u062D\u0631\u0643."
