  assetName: refuse
  displayNameLocalized:
    english: 
    arabic: 
  speaker: {fileID: 0}
  descriptionLocalized:
    english: "Gazing into your mirror, dark suspicion festers within you. The Seer's warning echoes in your mind, yet you lack tangible proof of treason. A dangerous gambit crosses your mind: employ the court Jester as your shadow spy."
    arabic: "تنظر في مرآتك، والشكوك المظلمة تعصف بفؤادك تجاه حاشيتك. يتردد صدى نبوءة العرافة في ذهنك، لكنك لا تملك دليلاً قاطعاً على الخيانة. تخطر ببالك مناورة جريئة: استخدام بهلوان القصر كجاسوس لك."
  dayAdvance: 5
  leftChoiceLocalized:
    english: "Too risky. If discovered, they will move against me."
    arabic: "مخاطرة كبرى. إن اكتشفوا الأمر، سينقلبون عليّ فوراً."
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: -10
    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: -5
  leftNextCard: {fileID: 11400000, guid: 3def12be6eb950a49bbcd2b9b3699d1f, type: 2}
  rightChoiceLocalized:
    english: "Set the trap. Catch them in the act and make them pay."
    arabic: "انصب الفخ. اضبطهم بالجرم المشهود واجعلهم يدفعون الثمن."
  rightResourceChange:
