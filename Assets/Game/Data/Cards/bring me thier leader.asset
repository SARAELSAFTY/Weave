  descriptionLocalized:
    english: 'the General:  that is the list of the people''s demands (Lower grain
      taxes end forced conscription, and open the royal granaries to feed the starving
      city).

      The Treasury Adviser: what a scandal.'
    arabic: "\u0627\u0644\u062C\u0646\u0631\u0627\u0644: \"\u0647\u0630\u0647 \u0642\u0627\u0626\u0645\u0629
      \u0628\u0645\u0637\u0627\u0644\u0628 \u0627\u0644\u0634\u0639\u0628 (\u062E\u0641\u0636
      \u0636\u0631\u0627\u0626\u0628 \u0627\u0644\u062D\u0628\u0648\u0628\u060C \u0625\u0646\u0647\u0627\u0621
      \u0627\u0644\u062A\u062C\u0646\u064A\u062F \u0627\u0644\u0625\u062C\u0628\u0627\u0631\u064A\u060C
      \u0648\u0641\u062A\u062D \u0645\u062E\u0627\u0632\u0646 \u0627\u0644\u063A\u0644\u0627\u0644
      \u0627\u0644\u0645\u0644\u0643\u064A\u0629 \u0644\u0625\u0637\u0639\u0627\u0645
      \u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0627\u0644\u062C\u0627\u0626\u0639\u0629).\"\n\n\u0645\u0633\u062A\u0634\u0627\u0631
      \u0627\u0644\u062E\u0632\u0627\u0646\u0629: \"\u064A\u0627 \u0644\u0647\u0627
      \u0645\u0646 \u0641\u0636\u064A\u062D\u0629!\""
  dayAdvance: 1
  leftChoiceLocalized:
    english: the crown does not negotiate with mobs.
    arabic: "\"\u0627\u0644\u062A\u0627\u062C \u0644\u0627 \u064A\u062A\u0641\u0627\u0648\u0636
