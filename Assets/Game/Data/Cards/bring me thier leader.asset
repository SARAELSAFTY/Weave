  leftNextCard: {fileID: 11400000, guid: 2b5fc4bd5427ca746be09401fb130f3e, type: 2}
  rightChoiceLocalized:
    english: Open the granaries and feed the starving.
    arabic: "\u0641\u062A\u062D \u0635\u0648\u0627\u0645\u0639 \u0627\u0644\u063A\u0644\u0627\u0644
      \u0648\u0625\u0637\u0639\u0627\u0645 \u0627\u0644\u062C\u0627\u0626\u0639\u064A\u0646
      \u0641\u0648\u0631\u0627\u064B."
