  leftNextCard: {fileID: 11400000, guid: 2b5fc4bd5427ca746be09401fb130f3e, type: 2}
  rightChoiceLocalized:
    english: "Open the granaries at once and grant them an audience\u2014if we do
      not yield today, we won't have a kingdom left to rule tomorrow."
    arabic: "\"\u0627\u0641\u062A\u062D\u0648\u0627 \u0645\u062E\u0627\u0632\u0646
