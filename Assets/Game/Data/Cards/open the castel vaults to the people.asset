  leftNextCard: {fileID: 11400000, guid: 3f247f0442dc80248a2bbe7e741b5a53, type: 2}
  rightChoiceLocalized:
    english: "Silence, fool! Do not mock royal matters."
    arabic: "اصمت أيها المهرج! لا تسخر من شؤون العرش."
