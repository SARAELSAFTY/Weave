  speaker: {fileID: 11400000, guid: bd422fef7c7a0976bcb3c39364963115, type: 2}
  descriptionLocalized:
    english: "Treasurer: 'Sire, Western merchants offer a fat annual tribute in exchange for exempting their wine and grain fleet from our harbor tolls.'"
    arabic: "أمين الخزينة: «يا مولاي، يعرض تجار الغرب جزية سنوية سخية مقابل إعفاء سفنهم من رسوم الموانئ البحرية.»"
  dayAdvance: 1
  leftChoiceLocalized:
    english: "Accept their gold; coin speaks louder than steel."
    arabic: "اقبل ذهبهم؛ فالمال أبلغ صوتاً من قرع السيوف."
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: -5
    - resource: {fileID: 11400000, guid: 1bd4e23f03990bc4d9ab64de0475c474, type: 2}
      value: 20
    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: -10
  leftNextCard: {fileID: 11400000, guid: e9cea82ea13bc0c8a904f0a8a9356b28, type: 2}
  rightChoiceLocalized:
    english: "Refuse; foreign merchants must respect royal sovereignty."
    arabic: "ارفض العرض؛ فلا مساومة على سيادة موانئنا."
  rightResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
