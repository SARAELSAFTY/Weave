  displayNameLocalized:
    english: 
    arabic: 
  speaker: {fileID: 11400000, guid: 968d4d0248269710a22f4c7dabc6a9cd, type: 2}
  descriptionLocalized:
    english: "General: 'Our guards breached the Chancellor's residence! We seized his secret ledgers and intercepted his sleeper couriers. The conspirator is chained in the dungeon, and his stolen loot is back in your vault!'"
    arabic: "الجنرال: «اقتحم حرسنا دار المستشار! ضبطنا دفاتره السرية ومراسلاته المشبوهة، وأودعناه في أعمق الزنازين، وعاد الذهب المنهوب إلى خزينتك!»"
  dayAdvance: 1
  leftChoiceLocalized:
    english: "Condemn him to solitary confinement for life."
    arabic: "احكم عليه بالسجن المؤبد في زنزانة انفرادية."
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: 10
    - resource: {fileID: 11400000, guid: 1bd4e23f03990bc4d9ab64de0475c474, type: 2}
      value: 5
    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: 5
  leftNextCard: {fileID: 11400000, guid: c0d4f65c6be52207ef287106604191dd, type: 2}
  rightChoiceLocalized:
    english: "Confiscate all his properties to fund our army."
    arabic: "صادر كامل أملاكه لصالح تعزيز دفاعات المملكة."
  rightResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
