  assetName: Card_15_CircusArrives
  displayNameLocalized:
    english: 
    arabic: 
  speaker: {fileID: 11400000, guid: 58e0d26dc32b25229dc4aef014036958, type: 2}
  descriptionLocalized:
    english: "The Jester bounds in, bells jingling: 'A grand traveling circus has pitched tents outside the city gates, Percy! Acrobats, fire-eaters, and a blind Seer who claims she can see tomorrow. Shall we let them perform?'"
    arabic: "يقفز البهلوان وتدق أجراسه: «سيرك عظيم نصب خيامه قرب أسوار المدينة يا بيرسي! بهلوانيون، نافثو لهب، وعرّافة عمياء تزعم أنها ترى الغد! أنأذن لهم بالعرض؟»"
  dayAdvance: 1
  leftChoiceLocalized:
    english: "Welcome the circus! The people need joy."
    arabic: "مرحباً بالسيرك! يحتاج الشعب إلى البهجة والترويح."
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: 5
    - resource: {fileID: 11400000, guid: 1bd4e23f03990bc4d9ab64de0475c474, type: 2}
      value: -5
    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: 0
  leftNextCard: {fileID: 11400000, guid: ee91b0081dc5bb3c54b5e4ea5c4e21d1, type: 2}
  rightChoiceLocalized:
    english: "Turn them away! Wandering troupes harbor spies."
    arabic: "اطردوهم! فخلف أقنعة المهرجين يندس الجواسيس."
  rightResourceChange:
