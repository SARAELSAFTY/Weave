  leftNextCard: {fileID: 11400000, guid: e0356b69f3e0bcb4aa9c1b635499ac94, type: 2}
  rightChoiceLocalized:
    english: "Arrest him! How dare you attempt to bribe your King?"
    arabic: "اقبضوا عليه! أتجرؤ على محاولة رشوة ملكك؟"
