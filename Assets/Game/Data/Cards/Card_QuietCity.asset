  m_Script: {fileID: 11500000, guid: 3a58f704bd5e67641b99574144c55bc6, type: 3}
  m_Name: Card_QuietCity
  m_EditorClassIdentifier: 
  assetName: Card_QuietCity
  displayNameLocalized:
    english: 
    arabic: 
  speaker: {fileID: 11400000, guid: 58e0d26dc32b25229dc4aef014036958, type: 2}
  descriptionLocalized:
    english: "The square beyond the gates is packed earth and silence. The Jester jingles once, unsmiling: 'No tents, no Seer, no songs. The city will remember you turned the joy away, Percy.'"
    arabic: "الساحة خلف البوابات تراب صامت بلا خيام. يدق البهلوان جرساً واحداً دون ابتسام: «لا سيرك، ولا عرّافة، ولا أغاني. سيتذكر أهل المدينة أنك طردت الفرح يا بيرسي.»"
  dayAdvance: 1
  leftChoiceLocalized:
    english: "Post a notice that the troupe was a nest of spies."
    arabic: "علّقوا بياناً أن الفرقة وكر جواسيس."
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: 5
    - resource: {fileID: 11400000, guid: 1bd4e23f03990bc4d9ab64de0475c474, type: 2}
      value: 0
    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: -5
  leftNextCard: {fileID: 11400000, guid: 6248617e6f8afba7058ffebd578de357, type: 2}
  rightChoiceLocalized:
    english: "Send a modest feast to the taverns to soothe the city."
    arabic: "أرسلوا مأدبة متواضعة إلى الحانات تطييباً للخاطر."
  rightResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
