  speaker: {fileID: 11400000, guid: 012f826a4ad563b4784233fe08d0f6b7, type: 2}
  descriptionLocalized:
    english: TEST 3 - Losing with resources. The left decree drops Gold past its
      collapse threshold and ends the reign with a generated epilogue. The right
      decree borrows instead and the story continues.
    arabic: "\u0627\u062E\u062A\u0628\u0627\u0631 \u0663 - \u0627\u0644\u062E\u0633\u0627\u0631\u0629
      \u0628\u0627\u0644\u0645\u0648\u0627\u0631\u062F. \u0627\u0644\u0623\u0645\u0631\u064F
      \u0627\u0644\u0623\u064A\u0633\u0631 \u064A\u0647\u0648\u064A \u0628\u0627\u0644\u0630\u0647\u0628
      \u062A\u062D\u062A \u062D\u062F\u0651 \u0627\u0644\u0627\u0646\u0647\u064A\u0627\u0631
      \u0641\u064A\u064F\u0646\u0647\u064A \u0627\u0644\u0645\u064F\u0644\u0643 \u0628\u062E\u0627\u062A\u0645\u0629
      \u0645\u064F\u0648\u0644\u064E\u0651\u062F\u0629. \u0627\u0644\u0623\u0645\u0631\u064F
      \u0627\u0644\u0623\u064A\u0645\u0646 \u064A\u0633\u062A\u0642\u0631\u0636 \u0648\u062A\u0633\u062A\u0645\u0631
      \u0627\u0644\u0642\u0635\u0629."
  dayAdvance: 1
  leftChoiceLocalized:
    english: Spend the vault to the last coin
    arabic: "\u0623\u0646\u0641\u0642 \u0627\u0644\u062E\u0632\u064A\u0646\u0629
      \u062D\u062A\u0649 \u0622\u062E\u0631 \u0639\u0645\u0644\u0629"
