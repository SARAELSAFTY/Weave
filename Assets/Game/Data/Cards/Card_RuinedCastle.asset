  assetName: Card_RuinedCastle
  displayNameLocalized:
    english: 
    arabic: 
  speaker: {fileID: 11400000, guid: 58e0d26dc32b25229dc4aef014036958, type: 2}
  descriptionLocalized:
    english: "In the mossy crypt of the Ruined Castle, you uncover a locked alcove. Inside rests a sealed portrait: your late father holding an infant boy beside a woman in motley—the Jester's true mother. He is your elder brother!"
    arabic: "في سرداب القلعة المهدمة، تعثر على حجرة سرية تخفي لوحة زيتية: والدك الراحل يحمل طفلاً رضيعاً إلى جانب امرأة بلباس البهلوانيين... إنها أم المهرج! البهلوان هو أخوك الأكبر الحقيقي!"
  dayAdvance: 1
  leftChoiceLocalized:
    english: "Burn the portrait to ash; keep the throne secure!"
    arabic: "احرق اللوحة حتى تصير رماداً؛ العرش لي وحدي!"
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: 15
    - resource: {fileID: 11400000, guid: 1bd4e23f03990bc4d9ab64de0475c474, type: 2}
      value: 0
    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: -15
  leftNextCard: {fileID: 11400000, guid: 09f85535c681ee9e5429d24c86cfb01a, type: 2}
  rightChoiceLocalized:
    english: "Embrace him as brother and name him co-ruler!"
    arabic: "اعترف به شقيقاً وشاركه حكم المملكة بالعدل!"
  rightResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: -10
    - resource: {fileID: 11400000, guid: 1bd4e23f03990bc4d9ab64de0475c474, type: 2}
