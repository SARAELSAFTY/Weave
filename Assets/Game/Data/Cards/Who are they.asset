  speaker: {fileID: 0}
  descriptionLocalized:
    english: "The Chancellor proposes a new tax decree upon the peasants. The Treasury Adviser gleefully applauds—promising royal vaults overflowing with gold, though unrest brews in the streets."
    arabic: "يقترح المستشار مرسوماً بفرض ضرائب إضافية على الفلاحين. ويصفق مستشار الخزانة بحماس—مؤكداً أن الذهب سيملاً خزائنك، رغم بوادر التململ في الشوارع."
  dayAdvance: 1
  leftChoiceLocalized:
    english: "Approve the decree; fill the treasury."
    arabic: "الموافقة على المرسوم؛ لملء الخزينة بالذهب."
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: 1bd4e23f03990bc4d9ab64de0475c474, type: 2}
      value: 20
    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: -15
  leftNextCard: {fileID: 11400000, guid: 855112f01e7e4444ea4e97526c76e9de, type: 2}
  rightChoiceLocalized:
    english: "Refuse; the people carry enough burdens."
    arabic: "الرفض؛ فالشعب يحمل ما يكفي من الأعباء."
