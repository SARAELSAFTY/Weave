  speaker: {fileID: 11400000, guid: c5e9af25f58fc364fa7f8feda2237cb4, type: 2}
  descriptionLocalized:
    english: 'A weather-beaten farmer''s representative kneels before you: ''Sire,
      black rot has consumed half our grain fields. If you demand full taxes, our
      children will starve before winter sets in!'''
    arabic: "\u064A\u0631\u0643\u0639 \u0641\u0644\u0627\u062D \u0623\u062C\u0647\u062F\u062A\u0647
      \u0627\u0644\u0633\u0646\u0648\u0646 \u0628\u064A\u0646 \u064A\u062F\u064A\u0643:
      \xAB\u064A\u0627 \u0645\u0648\u0644\u0627\u064A\u060C \u0627\u0644\u062A\u0647\u0645
      \u0627\u0644\u0639\u0641\u0646 \u0627\u0644\u0623\u0633\u0648\u062F \u0646\u0635\u0641
      \u062D\u0642\u0648\u0644 \u0627\u0644\u0642\u0645\u062D! \u0625\u0646 \u0623\u0644\u0632\u0645\u062A\u0645\u0648\u0646\u0627
      \u0628\u0643\u0627\u0645\u0644 \u0627\u0644\u062E\u0631\u0627\u062C\u060C \u0641\u0633\u062A\u0647\u0644\u0643
      \u0639\u0627\u0626\u0644\u0627\u062A\u0646\u0627 \u062C\u0648\u0639\u0627\u064B
      \u0642\u0628\u0644 \u0642\u062F\u0648\u0645 \u0627\u0644\u0634\u062A\u0627\u0621!\xBB"
