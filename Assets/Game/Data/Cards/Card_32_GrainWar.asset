  speaker: {fileID: 11400000, guid: bd422fef7c7a0976bcb3c39364963115, type: 2}
  descriptionLocalized:
    english: "Treasurer: 'In retaliation for the rejected deal, Westernia has halted all salt shipments to our kingdom. We must source salt elsewhere!'"
    arabic: "أمين الخزينة: «رداً على رفض الاتفاق، قطعت مملكة الغرب شحنات الملح عن أسواقنا! لا بد من تدبير بديل سريعاً.»"
  dayAdvance: 1
  leftChoiceLocalized:
    english: "Buy salt from the Eastern Kingdom at premium prices."
    arabic: "اشترِ الملح من مملكة الشرق ولو بأسعار مضاعفة."
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
