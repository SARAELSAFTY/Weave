  m_Script: {fileID: 11500000, guid: 3a58f704bd5e67641b99574144c55bc6, type: 3}
  m_Name: listen to the Chancellor and Treasury Adviser
  m_EditorClassIdentifier: 
  assetName: listen to the Chancellor and Treasury Adviser
  displayNameLocalized:
    english: 
    arabic: 
  speaker: {fileID: 11400000, guid: 8cb77cb474d02454da7d8e846e1f7633, type: 2}
  descriptionLocalized:
    english: "Sire, rumors of rebellion spread through the districts like wildfire. The peasants arm themselves with scythes and torches. Give me the word—shall we crush them before they march, or hear their demands?"
    arabic: "يا مولاي، شائعات التمرد تنتشر في الأحياء كالنار في الهشيم. الفلاحون يتسلحون بالمناجل والمشاعل. أعطني الأمر—أنسحقهم بقوة الحديد، أم نستمع إلى مطالبهم؟"
  dayAdvance: 1
  leftChoiceLocalized:
    english: "Whip them! Teach them what treason costs."
    arabic: "اجلدوهم! علّموهم ثمن الخيانة والعصيان."
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: 10
    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: -20
  leftNextCard: {fileID: 11400000, guid: 2130c932794c1db4c91c3c4eb1d247f5, type: 2}
  rightChoiceLocalized:
    english: "Bring me their leader. I will hear their grievances."
    arabic: "أحضروا إليّ زعيمهم؛ سأستمع إلى مطالبهم."
  rightResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: -5
    - resource: {fileID: 11400000, guid: 10d39ca6ec17c4442b381bbfe0578b71, type: 2}
      value: 15
  rightNextCard: {fileID: 11400000, guid: 3af559cb78b8a3045a8790650eed20b2, type: 2}
