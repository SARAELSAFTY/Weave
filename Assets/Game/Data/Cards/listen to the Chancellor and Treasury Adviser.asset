  speaker: {fileID: 0}
  descriptionLocalized:
    english: 'The General: there is a romar around the kindom some pesents are planing
      a reviolation agenst you, my lord we got the names of the rebels that we suspect,
      what should we do with them.'
    arabic: "\u0627\u0644\u062C\u0646\u0631\u0627\u0644: \"\u0647\u0646\u0627\u0643
      \u0634\u0627\u0626\u0639\u0627\u062A \u062A\u062F\u0648\u0631 \u0641\u064A
      \u062C\u0645\u064A\u0639 \u0623\u0646\u062D\u0627\u0621 \u0627\u0644\u0645\u0645\u0644\u0643\u0629\u060C
      \u0628\u0639\u0636 \u0627\u0644\u0641\u0644\u0627\u062D\u064A\u0646 \u064A\u062E\u0637\u0637\u0648\u0646
      \u0644\u0644\u062B\u0648\u0631\u0629 \u0636\u062F\u0643 \u064A\u0627 \u0645\u0648\u0644\u0627\u064A.
      \u0644\u0642\u062F \u062D\u0635\u0644\u0646\u0627 \u0639\u0644\u0649 \u0623\u0633\u0645\u0627\u0621
      \u0627\u0644\u0645\u062A\u0645\u0631\u062F\u064A\u0646 \u0627\u0644\u0645\u0634\u062A\u0628\u0647
      \u0628\u0647\u0645\u060C \u0645\u0627\u0630\u0627 \u0646\u0641\u0639\u0644
      \u0628\u0647\u0645\u061F\""
