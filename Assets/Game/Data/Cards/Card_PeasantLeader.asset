  leftNextCard: {fileID: 11400000, guid: 72632fc3aed058c6aa1935fde05599b3, type: 2}
  rightChoiceLocalized:
    english: "Open royal granaries! Feed them and grant a pardon."
    arabic: "افتحوا صوامع الغلال الملكية! أطعموهم واصفحوا عنهم."
