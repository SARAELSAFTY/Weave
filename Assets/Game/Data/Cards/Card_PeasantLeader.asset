  speaker: {fileID: 11400000, guid: 968d4d0248269710a22f4c7dabc6a9cd, type: 2}
  descriptionLocalized:
    english: "General: 'Sire! Five thousand furious peasants have marched upon the palace gate, demanding bread! We arrested their ringleader in chains. What is his sentence?'"
    arabic: "الجنرال: «يا مولاي! خمسة آلاف فلاح غاضب يحاصرون بوابات القصر مطالبين بالخبز! اعتقلنا زعيم تمردهم بالأصفاد. فما حكمك عليه؟»"
  dayAdvance: 1
  leftChoiceLocalized:
    english: "Execute him publicly; quell this treason with iron!"
    arabic: "أعدمه علناً في الميدان لردع الرعاع عن العصيان!"
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
