  assetName: Card_01_MotherGhost
  displayNameLocalized:
    english: 
    arabic: 
  speaker: {fileID: 11400000, guid: 955c23e0b4b52b58398e46bb89677072, type: 2}
  descriptionLocalized:
    english: "Cold mist gathers around your canopy bed. Your mother's ghost leans close: 'Percy, waking up with a crown does not make you a ruler. The Eastern border burns. Will you rule with iron or ink?'"
    arabic: "يتصاعد ضباب بارد حول سريرك الملكي، ويدنو طيف والدتك هامساً: «يا بيرسي، ليس كل من استيقظ وعلى رأسه تاج صار ملكاً حقاً! حدود الشرق تشتعل، فهل ستحكم بالحديد أم بالحبر؟»"
  dayAdvance: 1
  leftChoiceLocalized:
    english: "Gather the war council; march on the East."
    arabic: "اجمع مجلس الحرب؛ سنزحف نحو الشرق فوراً!"
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: 5
    - resource: {fileID: 11400000, guid: 1bd4e23f03990bc4d9ab64de0475c474, type: 2}
