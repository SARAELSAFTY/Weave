      value: 10
  leftNextCard: {fileID: 11400000, guid: 22492d7cc495a94bf4152c946778d1b2, type: 2}
  rightChoiceLocalized:
    english: "Summon diplomats; offer alliance and trade."
    arabic: "استدعِ السفراء؛ اعرض التحالف والمصالح المشتركة."
