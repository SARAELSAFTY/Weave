      value: 10
  leftNextCard: {fileID: 11400000, guid: 92c19644e0fd583134ac2a87a6b7c0ea, type: 2}
  rightChoiceLocalized:
    english: "Hold defensive lines; do not escalate."
    arabic: "الزموا الخطوط الدفاعية؛ لا أريد تصعيداً غير محسوب."
  rightResourceChange:
