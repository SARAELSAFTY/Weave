  speaker: {fileID: 11400000, guid: 968d4d0248269710a22f4c7dabc6a9cd, type: 2}
  descriptionLocalized:
    english: 'General: ''Sire, the Eastern Kingdom''s border raiders burned three
      of our grain mills. We must strike their garrisons before dawn!'''
    arabic: "\u0627\u0644\u062C\u0646\u0631\u0627\u0644: \xAB\u064A\u0627 \u0645\u0648\u0644\u0627\u064A\u060C
      \u0623\u062D\u0631\u0642\u062A \u063A\u0627\u0631\u0627\u062A \u0645\u0645\u0644\u0643\u0629
      \u0627\u0644\u0634\u0631\u0642 \u062B\u0644\u0627\u062B\u0629 \u0645\u0646
      \u0637\u0648\u0627\u062D\u064A\u0646 \u0642\u0645\u062D\u0646\u0627! \u0644\u0627
      \u0628\u062F \u0645\u0646 \u0645\u0628\u0627\u063A\u062A\u0629 \u062B\u0643\u0646\u0627\u062A\u0647\u0645
      \u0642\u0628\u0644 \u0628\u0632\u0648\u063A \u0627\u0644\u0641\u062C\u0631!\xBB"
  dayAdvance: 1
  leftChoiceLocalized:
    english: Mobilize the vanguard; burn their outposts.
    arabic: "\u062D\u0631\u0651\u0643 \u0637\u0644\u064A\u0639\u0629 \u0627\u0644\u062C\u064A\u0634\u060C
      \u0648\u0623\u0634\u0639\u0644 \u0627\u0644\u0646\u0627\u0631 \u0641\u064A
      \u062D\u0635\u0648\u0646\u0647\u0645."
