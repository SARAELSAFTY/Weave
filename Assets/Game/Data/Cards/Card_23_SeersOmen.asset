  speaker: {fileID: 11400000, guid: b03696b9fe28e4290e0808855683bfe3, type: 2}
  descriptionLocalized:
    english: "The blind Seer raises her withered hands through aromatic incense: 'Little king... the western sea churns with warships. War or coin, blood or bread—the tide comes for your throne. How will you answer?'"
    arabic: "ترفع العرّافة العمياء كفيها وسط دخان البخور العبق: «أيها الملك الصغير... بحار الغرب تموج بالسفن الحربية! حربٌ أم ذهب، دمٌ أم خبز—المد القادم يهدد عرشك، فكيف ستجيب؟»"
  dayAdvance: 1
  leftChoiceLocalized:
    english: "Prepare war galleys and burn their fleet first!"
    arabic: "جهّز السفن الحربية وأشعل النيران في أسطولهم مباغتة!"
  leftResourceChange:
    values:
    - resource: {fileID: 11400000, guid: b891174f857049f44be00b474746951e, type: 2}
      value: 5
    - resource: {fileID: 11400000, guid: 1bd4e23f03990bc4d9ab64de0475c474, type: 2}
