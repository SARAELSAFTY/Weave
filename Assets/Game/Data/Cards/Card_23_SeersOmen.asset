  leftNextCard: {fileID: 11400000, guid: 8f34778cd85d3c8b20d5ae45e42c42e2, type: 2}
  rightChoiceLocalized:
    english: "Strengthen our harbors and propose trade tolls."
    arabic: "حصّن موانئنا واعرض عليهم اتفاقاً لتنظيم رسوم الملاحة."
  rightResourceChange:
