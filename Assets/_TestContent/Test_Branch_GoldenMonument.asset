  speaker: {fileID: 11400000, guid: 9056cff22f8660e4c88d97f7d7f6548b, type: 2}
  descriptionLocalized:
    english: The Chancellor bows low, smile dripping silk. 'Sire, let the commoners
      see your glory. A double harvest tax to raise a golden monument in your likeness
      - what could possibly go wrong?'
    arabic: "\u064A\u0646\u062D\u0646\u064A \u0627\u0644\u0645\u0633\u062A\u0634\u0627\u0631
      \u0628\u0627\u0628\u062A\u0633\u0627\u0645\u0629 \u062A\u0642\u0637\u0631 \u062D\u0631\u064A\u0631\u064B\u0627:
      \xAB\u0645\u0648\u0644\u0627\u064A\u060C \u062F\u0639 \u0627\u0644\u0631\u0639\u064A\u0629
      \u062A\u0631\u0649 \u0645\u062C\u062F\u0643. \u0636\u0631\u064A\u0628\u0629
      \u062D\u0635\u0627\u062F \u0645\u0636\u0627\u0639\u0641\u0629 \u0644\u062A\u0634\u064A\u064A\u062F
      \u0646\u0635\u0628 \u0630\u0647\u0628\u064A \u064A\u062C\u0633\u062F \u0639\u0638\u0645\u062A\u0643
      - \u0641\u0645\u0627 \u0627\u0644\u0630\u064A \u0642\u062F \u064A\u0633\u0648\u0621\u061F\xBB"
  dayAdvance: 2
  leftChoiceLocalized:
    english: Raise the golden monument
    arabic: "\u0634\u064A\u0651\u062F \u0627\u0644\u0646\u0635\u0628 \u0627\u0644\u0630\u0647\u0628\u064A"
