  assetName: Test_Scene_GeneralDiplomacy
  displayName: The General's Diplomacy
  displayNameLocalized:
    english: 
    arabic: 
  speaker: {fileID: 11400000, guid: da796e51b6a4e4b40852385f9741f737, type: 2}
  descriptionLocalized:
    english: 'The General slams his gauntlet on the map. ''Raiders test the border!
      My diplomatic masterstroke: send the entire cavalry in a crushing charge. Nothing
      says peace like a perfect victory.'''
    arabic: "\u064A\u0636\u0631\u0628 \u0627\u0644\u062C\u0646\u0631\u0627\u0644
      \u0642\u0641\u0627\u0632\u0647 \u0639\u0644\u0649 \u0627\u0644\u062E\u0631\u064A\u0637\u0629:
      \xAB\u0627\u0644\u063A\u0632\u0627\u0629 \u064A\u062E\u062A\u0628\u0631\u0648\u0646
      \u0627\u0644\u062D\u062F\u0648\u062F! \u0648\u062E\u0637\u062A\u064A \u0627\u0644\u062F\u0628\u0644\u0648\u0645\u0627\u0633\u064A\u0629
      \u0627\u0644\u0639\u0628\u0642\u0631\u064A\u0629: \u0623\u0631\u0633\u0644
      \u0627\u0644\u0641\u0631\u0633\u0627\u0646 \u0643\u0644\u0647\u0645 \u0641\u064A
      \u0647\u062C\u0648\u0645 \u0633\u0627\u062D\u0642. \u0641\u0644\u0627 \u0634\u064A\u0621
      \u064A\u0642\u0648\u0644 \u0627\u0644\u0633\u0644\u0627\u0645 \u0643\u0627\u0646\u062A\u0635\u0627\u0631
      \u062A\u0627\u0645\xBB."
  dayAdvance: 2
  leftChoiceLocalized:
    english: Send the cavalry charge
    arabic: "\u0623\u0631\u0633\u0644 \u0647\u062C\u0648\u0645 \u0627\u0644\u0641\u0631\u0633\u0627\u0646
      \u0627\u0644\u0633\u0627\u062D\u0642"
