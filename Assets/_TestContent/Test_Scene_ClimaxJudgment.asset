  speaker: {fileID: 11400000, guid: e88d1e153d9a35d4bae59abf669e4a93, type: 2}
  descriptionLocalized:
    english: The Spirit Mother blazes in spectral light. 'The hour is here, my son.
      The realm stands on a knife's edge. Will you give yourself to the people, or
      burn the kingdom to feed your pride?'
    arabic: "\u062A\u062A\u0648\u0647\u062C \u0631\u0648\u062D \u0627\u0644\u0623\u0645
      \u0628\u0636\u064A\u0627\u0621 \u0637\u064A\u0641\u064A: \xAB\u0644\u0642\u062F
      \u062D\u0627\u0646\u062A \u0627\u0644\u0633\u0627\u0639\u0629 \u064A\u0627
      \u0648\u0644\u062F\u064A. \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0639\u0644\u0649
      \u062D\u062F \u0627\u0644\u0633\u0643\u064A\u0646. \u0641\u0625\u0645\u0627
      \u0623\u0646 \u062A\u0628\u0630\u0644 \u0646\u0641\u0633\u0643 \u0644\u0644\u0634\u0639\u0628\u060C
      \u0623\u0648 \u062A\u062D\u0631\u0642 \u0627\u0644\u0645\u0645\u0644\u0643\u0629
      \u0644\u062A\u063A\u0630\u064A \u0643\u0628\u0631\u064A\u0627\u0621\u0643\u061F\xBB"
  dayAdvance: 2
  leftChoiceLocalized:
    english: The realm before the king
    arabic: "\u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0642\u0628\u0644 \u0627\u0644\u0645\u0644\u0643"
