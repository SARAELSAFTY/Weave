  speaker: {fileID: 11400000, guid: 86ddb2ff8d2793a4491b486d218c24cf, type: 2}
  descriptionLocalized:
    english: The Treasury Adviser presents a neat ledger. 'Sire, hand me sole control
      of the vaults and I shall double your wealth. Trust me entirely - what is a
      king's purse without a faithful keeper?'
    arabic: "\u064A\u0642\u062F\u0645 \u0645\u0633\u062A\u0634\u0627\u0631 \u0627\u0644\u062E\u0632\u0627\u0646\u0629
      \u062F\u0641\u062A\u0631\u064B\u0627 \u0645\u0631\u062A\u0628\u064B\u0627:
      \xAB\u0645\u0648\u0644\u0627\u064A\u060C \u0633\u0644\u0645\u0646\u064A \u0648\u062D\u062F\u064A
      \u0645\u0641\u0627\u062A\u064A\u062D \u0627\u0644\u062E\u0632\u0627\u0626\u0646
      \u0648\u0633\u0623\u0636\u0627\u0639\u0641 \u062B\u0631\u0648\u062A\u0643.
      \u062B\u0642 \u0628\u064A \u062B\u0642\u0629 \u0643\u0627\u0645\u0644\u0629
      - \u0641\u0645\u0627 \u0643\u064A\u0633 \u0627\u0644\u0645\u0644\u0643 \u0628\u0644\u0627
      \u0623\u0645\u064A\u0646 \u0648\u0641\u064A\u061F\xBB"
  dayAdvance: 2
  leftChoiceLocalized:
    english: Give him sole control of the vaults
    arabic: "\u0633\u0644\u0651\u0645\u0647 \u0648\u062D\u062F\u0647 \u0645\u0641\u0627\u062A\u064A\u062D
