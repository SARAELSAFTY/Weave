  displayName: The Spectral Awakening
  displayNameLocalized:
    english: 
    arabic: 
  speaker: {fileID: 11400000, guid: e88d1e153d9a35d4bae59abf669e4a93, type: 2}
  descriptionLocalized:
    english: A cold mist gathers above the royal dais. The ghostly figure of your
      late mother appears, looking down at you with stern sorrow. 'My spoiled son...
      your arrogance will drown this realm unless you learn to rule.'
    arabic: "\u064A\u062A\u0635\u0627\u0639\u062F \u0636\u0628\u0627\u0628 \u0628\u0627\u0631\u062F
      \u0641\u0648\u0642 \u0627\u0644\u0639\u0631\u0634 \u0627\u0644\u0645\u0644\u0643\u064A.
      \u064A\u0638\u0647\u0631 \u0637\u064A\u0641 \u0648\u0627\u0644\u062F\u062A\u0643
      \u0627\u0644\u0631\u0627\u062D\u0644\u0629 \u0646\u0627\u0638\u0631\u064B\u0627
      \u0625\u0644\u064A\u0643 \u0628\u062D\u0632\u0646 \u0648\u062D\u0632\u0645:
      '\u064A\u0627 \u0648\u0644\u062F\u064A \u0627\u0644\u0645\u062F\u0644\u0644...
      \u0625\u0646 \u063A\u0631\u0648\u0631\u0643 \u0633\u064A\u063A\u0631\u0642
      \u0647\u0630\u0647 \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0625\u0646
      \u0644\u0645 \u062A\u062A\u0639\u0644\u0645 \u0643\u064A\u0641 \u062A\u062D\u0643\u0645
      \u062D\u0642\u064B\u0627.'"
  dayAdvance: 1
  leftChoiceLocalized:
    english: Dismiss as a fever dream
    arabic: "\u062A\u062C\u0627\u0647\u0644 \u0627\u0644\u0637\u064A\u0641 \u0643\u0623\u0646\u0647
      \u0643\u0627\u0628\u0648\u0633"
