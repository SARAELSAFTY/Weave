      \u0648\u062D\u0631\u0633 \u0627\u0644\u0628\u0644\u0627\u0637\u060C \u064A\u0631\u0641\u0639
      \u0627\u0644\u062A\u0627\u062C \u0639\u0646 \u0631\u0623\u0633\u0643 \u0648\u064A\u0639\u0644\u0646
