  speaker: {fileID: 11400000, guid: 86ddb2ff8d2793a4491b486d218c24cf, type: 2}
  descriptionLocalized:
    english: The vaults stand open and empty. The Treasury Adviser has sailed across
      the sea with every sovereign coin, leaving a broke king to face unpaid, angry
      mercenaries.
    arabic: "\u062A\u0642\u0641 \u0627\u0644\u062E\u0632\u0627\u0626\u0646 \u0645\u0641\u062A\u0648\u062D\u0629
      \u0648\u062E\u0627\u0648\u064A\u0629. \u0623\u0628\u062D\u0631 \u0645\u0633\u062A\u0634\u0627\u0631
      \u0627\u0644\u062E\u0632\u0627\u0646\u0629 \u0639\u0628\u0631 \u0627\u0644\u0628\u062D\u0631
      \u0628\u0643\u0644 \u0642\u0637\u0639\u0629 \u0630\u0647\u0628\u060C \u062A\u0627\u0631\u0643\u064B\u0627
      \u0645\u0644\u0643\u064B\u0627 \u0645\u0641\u0644\u0633\u064B\u0627 \u0644\u064A\u0648\u0627\u062C\u0647
      \u0645\u0631\u062A\u0632\u0642\u0629 \u063A\u0627\u0636\u0628\u064A\u0646 \u0644\u0645
      \u064A\u064F\u062F\u0641\u0639 \u0644\u0647\u0645."
