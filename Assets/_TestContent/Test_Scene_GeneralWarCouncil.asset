  displayName: The General's Diplomacy
  displayNameLocalized:
    english: 
    arabic: 
  speaker: {fileID: 11400000, guid: da796e51b6a4e4b40852385f9741f737, type: 2}
  descriptionLocalized:
    english: 'General Valerius storms into council, slamming his iron gauntlet on
      the map. ''Raiders test our borders! My strategy is a brilliant diplomatic
      masterstroke: send the entire cavalry in a crushing charge!'''
    arabic: "\u064A\u0642\u062A\u062D\u0645 \u0627\u0644\u062C\u0646\u0631\u0627\u0644
      \u0641\u0627\u0644\u064A\u0631\u064A\u0648\u0633 \u0627\u0644\u0642\u0627\u0639\u0629
      \u0636\u0627\u0631\u0628\u064B\u0627 \u0642\u0641\u0627\u0632\u0647 \u0627\u0644\u062D\u0631\u0628\u064A
      \u0639\u0644\u0649 \u0627\u0644\u062E\u0631\u064A\u0637\u0629: '\u0627\u0644\u063A\u0632\u0627\u0629
      \u064A\u062E\u062A\u0628\u0631\u0648\u0646 \u062D\u062F\u0648\u062F\u0646\u0627!
      \u062E\u0637\u062A\u064A \u0647\u064A \u062A\u062D\u0641\u0629 \u062F\u0628\u0644\u0648\u0645\u0627\u0633\u064A\u0629
      \u0628\u0627\u0631\u0639\u0629: \u0623\u0631\u0633\u0644 \u0633\u0644\u0627\u062D
      \u0627\u0644\u0641\u0631\u0633\u0627\u0646 \u0628\u0623\u0643\u0645\u0644\u0647
      \u0641\u064A \u0647\u062C\u0648\u0645 \u0633\u0627\u062D\u0642!'"
  dayAdvance: 2
  leftChoiceLocalized:
    english: Full cavalry charge!
    arabic: "\u0647\u062C\u0648\u0645 \u0643\u0627\u0633\u062D \u0628\u0627\u0644\u0641\u0631\u0633\u0627\u0646!"
