  displayName: The Fool's Feast
  displayNameLocalized:
    english: 
    arabic: 
  speaker: {fileID: 11400000, guid: 8ae3b499470a8134a8246588163389f3, type: 2}
  descriptionLocalized:
    english: The Jester cartwheels into the throne room, jingling bells in your face.
      'Brother King! The thieves scheme to loot the granaries! Why not throw the
      gates open and feed every beggar before they steal a crumb?'
    arabic: "\u064A\u062A\u0634\u0642\u0644\u0628 \u0627\u0644\u0645\u0647\u0631\u062C
      \u062F\u0627\u062E\u0644 \u0642\u0627\u0639\u0629 \u0627\u0644\u0639\u0631\u0634
      \u0631\u0627\u0646\u064B\u0627 \u0623\u062C\u0631\u0627\u0633\u0647 \u0641\u064A
      \u0648\u062C\u0647\u0643: '\u0623\u062E\u064A \u0627\u0644\u0645\u0644\u0643!
      \u0627\u0644\u0644\u0635\u0648\u0635 \u064A\u062E\u0637\u0637\u0648\u0646 \u0644\u0646\u0647\u0628
      \u0645\u062E\u0627\u0632\u0646 \u0627\u0644\u062D\u0628\u0648\u0628! \u0644\u0645\u064E
      \u0644\u0627 \u0646\u0641\u062A\u062D \u0627\u0644\u0623\u0628\u0648\u0627\u0628
      \u0648\u0646\u0637\u0639\u0645 \u0643\u0644 \u0645\u062A\u0633\u0648\u0644
      \u0642\u0628\u0644 \u0623\u0646 \u064A\u0633\u0631\u0642\u0648\u0627 \u0643\u0633\u0631\u0629
      \u0648\u0627\u062D\u062F\u0629\u061F'"
  dayAdvance: 2
  leftChoiceLocalized:
    english: Host the grand Fool's Feast!
    arabic: "\u0623\u0642\u0645 \u0648\u0644\u064A\u0645\u0629 \u0627\u0644\u0645\u0647\u0631\u062C
      \u0627\u0644\u0643\u0628\u0631\u0649!"
