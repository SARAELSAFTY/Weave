  displayName: The Spectral Judgment
  displayNameLocalized:
    english: 
    arabic: 
  speaker: {fileID: 11400000, guid: e88d1e153d9a35d4bae59abf669e4a93, type: 2}
  descriptionLocalized:
    english: The Spirit Mother materializes amidst thunderous spectral light. 'The
      hour has come, my son. The realm stands upon the precipice. Will you sacrifice
      your selfish pride for the people, or burn this kingdom to feed your vanity?'
    arabic: "\u062A\u062A\u062C\u0633\u062F \u0631\u0648\u062D \u0627\u0644\u0623\u0645
      \u0648\u0633\u0637 \u0636\u064A\u0627\u0621 \u0637\u064A\u0641\u064A \u0645\u062F\u0648\u064D\u0651:
      '\u0644\u0642\u062F \u062D\u0627\u0646\u062A \u0627\u0644\u0644\u062D\u0638\u0629
      \u064A\u0627 \u0648\u0644\u062F\u064A. \u0627\u0644\u0645\u0645\u0644\u0643\u0629
      \u062A\u0642\u0641 \u0639\u0644\u0649 \u062D\u0627\u0641\u0629 \u0627\u0644\u0647\u0627\u0648\u064A\u0629.
      \u0647\u0644 \u062A\u0636\u062D\u064A \u0628\u0643\u0628\u0631\u064A\u0627\u0626\u0643
      \u0627\u0644\u0623\u0646\u0627\u0646\u064A \u0645\u0646 \u0623\u062C\u0644
      \u0634\u0639\u0628\u0643\u060C \u0623\u0645 \u062A\u062D\u0631\u0642 \u0627\u0644\u0645\u0645\u0644\u0643\u0629
      \u0644\u062A\u063A\u0630\u064A \u063A\u0631\u0648\u0631\u0643\u061F'"
  dayAdvance: 2
  leftChoiceLocalized:
    english: The realm comes before the King!
    arabic: "\u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u062A\u0623\u062A\u064A
      \u0642\u0628\u0644 \u0627\u0644\u0645\u0644\u0643!"
