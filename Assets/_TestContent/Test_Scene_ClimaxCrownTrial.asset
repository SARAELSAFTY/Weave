  rightChoiceLocalized:
    english: I am Sovereign! All must bow!
    arabic: "\u0623\u0646\u0627 \u0627\u0644\u0645\u0644\u0643 \u0627\u0644\u0623\u0648\u062D\u062F!
      \u0648\u0627\u0644\u062C\u0645\u064A\u0639 \u0633\u064A\u0646\u062D\u0646\u064A!"
