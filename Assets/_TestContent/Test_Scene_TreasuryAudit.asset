  speaker: {fileID: 11400000, guid: 86ddb2ff8d2793a4491b486d218c24cf, type: 2}
  descriptionLocalized:
    english: Treasury Adviser Midas taps his ledger with a sharp quill. 'Sire, the
      vaults are leaking coin. Grant me unilateral authority over trade tolls and
      merchant taxes, and I shall make the crown wealthier than the gods.'
    arabic: "\u064A\u0646\u0642\u0631 \u0645\u0633\u062A\u0634\u0627\u0631 \u0627\u0644\u062E\u0632\u0627\u0646\u0629
      \u0645\u064A\u062F\u0627\u0633 \u0639\u0644\u0649 \u0633\u062C\u0644\u0647
      \u0628\u0631\u064A\u0634\u0629 \u062D\u0627\u062F\u0629: '\u064A\u0627 \u0645\u0648\u0644\u0627\u064A\u060C
      \u0627\u0644\u062E\u0632\u0627\u0626\u0646 \u062A\u0646\u0632\u0641 \u0630\u0647\u0628\u064B\u0627.
      \u0627\u0645\u0646\u062D\u0646\u064A \u0627\u0644\u0633\u064A\u0637\u0631\u0629
      \u0627\u0644\u0643\u0627\u0645\u0644\u0629 \u0639\u0644\u0649 \u0645\u0643\u0648\u0633
      \u0627\u0644\u062A\u062C\u0627\u0631\u0629 \u0648\u0636\u0631\u0627\u0626\u0628
      \u0627\u0644\u062A\u062C\u0627\u0631\u060C \u0648\u0633\u0623\u062C\u0639\u0644
      \u0627\u0644\u062A\u0627\u062C \u0623\u063A\u0646\u0649 \u0645\u0646 \u0627\u0644\u0622\u0644\u0647\u0629.'"
  dayAdvance: 2
  leftChoiceLocalized:
    english: Grant Midas total ledger control
    arabic: "\u0627\u0645\u0646\u062D \u0645\u064A\u062F\u0627\u0633 \u0627\u0644\u0633\u064A\u0637\u0631\u0629
